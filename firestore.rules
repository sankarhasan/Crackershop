rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------------
    // Admin authorization: true ONLY when Firebase Auth's servers stamped
    // the cryptographically-signed `admin: true` custom claim on the signed
    // in user's UID (granted with scripts/set-admin-claim.js). Frontend
    // flags, localStorage, URLs and user-editable documents are NEVER
    // consulted. This check runs on Google's servers, so a modified admin.js
    // cannot bypass it — unauthorized callers get PERMISSION_DENIED.
    // ---------------------------------------------------------------------
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // ---- Catalog content: public storefront read, admin-only write ----
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ---- Marketing surfaces: public read, admin-only write ----
    match /banners/{bannerId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Offers: public read; the storefront's one-time default seed (js/data.js)
    // may create the doc only when it does not exist yet; after that,
    // only an admin can edit the live offer.
    match /offers/{offerId} {
      allow read: if true;
      allow create: if isAdmin() || !exists();
      allow update, delete: if isAdmin();
    }

    match /coupons/{couponId} {
      allow read: if true;                // checkout coupon validation
      allow create, update, delete: if isAdmin();
    }

    match /stateRules/{stateRuleId} {
      allow read: if true;                // storefront minimum-order check
      allow create, update, delete: if isAdmin();
    }

    match /spin_wheel_config/{configId} {
      allow read: if true;                // wheel segments for every visitor
      allow create, update, delete: if isAdmin();
    }

    // ---- Enquiries / orders ----
    // * anyone (guest or customer) may SUBMIT a new enquiry;
    // * a signed-in customer may read ONLY their own orders
    //   (the portal queries where customer.userId == uid, which this
    //   owner check provably satisfies);
    // * only the admin may read the full list, change statuses, or delete.
    match /enquiries/{enquiryId} {
      allow create: if true;
      allow read: if isAdmin()
                  || (request.auth != null
                      && request.auth.uid == resource.data.customer.userId);
      allow update, delete: if isAdmin();
    }

    // ---- Reviews: customers read & submit; only admin moderates ----
    match /product_reviews/{reviewId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // ---- Per-user private docs (spin cooldown, cart sync) ----
    // Owner may read/write their own doc; admin may reach it for support.
    // NOTE: path variable {userId} must match the authenticated uid.
    match /users/{userId} {
      allow read, write: if isAdmin()
                         || (request.auth != null && request.auth.uid == userId);
    }

    // ---- Wishlists: strictly owner-only ----
    match /wishlists/{userId} {
      allow read, write: if isAdmin()
                         || (request.auth != null && request.auth.uid == userId);
    }

    // ---- Activities: admin dashboard audit feed only ----
    match /activities/{activityId} {
      allow read, create, update, delete: if isAdmin();
    }

    // ---- Billing / Invoice module (in-store POS) ----
    // Invoices, the sequential numbering counter, and shop billing settings are
    // strictly admin-only. Invoice numbering runs as a client-side Firestore
    // transaction authenticated with the admin token, so both the counter doc
    // and the invoice write require the signed `admin: true` claim.
    match /invoices/{invoiceId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /invoice_counters/{period} {
      allow read, create, update: if isAdmin();
      allow delete: if false;
    }

    // Shop billing profile (name, address, GSTIN, logo, tax config). Read is
    // public so a printable/downloaded invoice can be rendered from any device;
    // only an admin may change it.
    match /billing_settings/{settingsId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // NOTE: Admin credentials live in Firebase Authentication ONLY — never
    // in Firestore. updateEmail()/updatePassword() are sensitive operations
    // that Firebase servers reject without recent reauthentication, so no
    // plaintext password or verification secret is ever stored client-side.
  }
}
